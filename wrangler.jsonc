{
  "name": "virus-stella",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,

  // 스텔컴퍼니와 같은 D1 데이터베이스를 연결해야 돈과 계정이 연동됩니다.
  // 스텔컴퍼니 저장소의 wrangler 파일이나 Cloudflare 대시보드(Storage & Databases → D1)에서
  // database_name 과 database_id 를 그대로 복사해 넣으세요.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stellcompany",
      "database_id": "48def5bd-8c42-48e9-ba14-52e6d5e3fe0c"
    }
  ],

  // 스텔컴퍼니 사이트 주소 (시작 메뉴 링크용)
  "vars": {
    "STELL_URL": "https://stellcompany-workers.yj976400.workers.dev/"
  }

  // SESSION_SECRET, DISCORD_CLIENT_ID, DISCORD_CLIENT_SECRET 은
  // 파일에 적지 말고 대시보드 Settings → Variables and Secrets 에 Secret으로 넣으세요.
}
